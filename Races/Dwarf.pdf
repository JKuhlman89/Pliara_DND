     /Type /StructElem
  >>
endobj

1462 0 obj
  << /ActualText (Ability Scores\056 Years of mountain climbing and shaping have toned your arms and core\056 Your Strength Score increases by 1 point\056\nMountain Climber\056 You have advantage on Strength \050Athletics\051 skill checks for climbing\056 You also have advantage on any Wisdom \050Survival\051 checks made when travelling in a mountainous setting\054 including within mountain caves\056\n)
     /K [ 3 ]
     /P 1463 0 R
     /Pg 1432 0 R
